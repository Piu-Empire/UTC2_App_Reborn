<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_icon_yellow.xml
    Nền vàng nhạt bo góc dùng cho container icon tính năng.
    Đặt tại: res/drawable/bg_icon_yellow.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient tỏa ra từ giữa, nhạt dần ra viền màu trắng để tạo hiệu ứng hòa trộn -->
    <gradient
        android:type="radial"
        android:gradientRadius="36dp"
        android:startColor="#FFF3CD"
        android:centerColor="#FFFAEB"
        android:endColor="#FFFFFF" />

    <corners android:radius="16dp" />

</shape>