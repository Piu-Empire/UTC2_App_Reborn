<?xml version="1.0" encoding="utf-8"?>
<!--
    item_assessment_footer_cvht.xml
    Chứa:
    - Ý kiến sinh viên + EditText
    - Lưu ý kiểm tra trước khi nộp
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_cvht_opinion_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#CC0000"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_cvht_opinion_hint"
        android:textSize="12sp"
        android:textColor="#555"
        android:lineSpacingMultiplier="1.3"
        android:paddingBottom="8dp"/>

    <EditText
        android:id="@+id/etOpinion"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_period_dropdown"
        android:gravity="top|start"
        android:padding="10dp"
        android:inputType="textMultiLine"
        android:textSize="13sp"
        android:hint="Nhập ý kiến..."
        android:textColorHint="@color/assessment_score_border"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assessment_cvht_reminder"
        android:textSize="12sp"
        android:textColor="#CC0000"
        android:textStyle="italic"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

</LinearLayout>