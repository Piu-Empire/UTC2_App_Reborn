<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_search.xml
    ──────────────────────────────────────────────────────────────
    Layout màn hình tìm kiếm toàn cục.

    Cấu trúc:
      1. Toolbar: nút Back + ô EditText tìm kiếm + nút Clear (X)
      2. layoutSuggestions: gợi ý nhanh bằng Chip (hiện khi chưa nhập)
      3. rvResults: danh sách kết quả (hiện khi có kết quả)
      4. layoutEmpty: trạng thái "Không tìm thấy" (hiện khi nhập nhưng rỗng)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- ══════════════════════════════════════════════
         TOOLBAR: Back + Search input + Clear
         ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="@color/toolbar_collapsed_bg"
        android:elevation="4dp">

        <!-- Nút Back -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Quay lại"
            app:tint="@color/white" />

        <!-- Ô tìm kiếm -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="40dp"
            android:hint="Tìm kiếm tính năng, tin tức…"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="#99000000"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <!-- Nút Clear (X) — ẩn khi chưa có text -->
        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="Xóa"
            android:visibility="gone"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000" />

    <!-- ══════════════════════════════════════════════
         GỢI Ý NHANH — hiện khi ô tìm kiếm còn trống
         ══════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layout_suggestions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gợi ý tìm kiếm nhanh"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Chips hàng 1 -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hoc_phi"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Học phí"
                    app:chipBackgroundColor="#F5F5F5"
                    app:chipStrokeColor="#E0E0E0"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lich"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch học"
                    app:chipBackgroundColor="#F5F5F5"
                    app:chipStrokeColor="#E0E0E0"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_dich_vu"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dịch vụ công"
                    app:chipBackgroundColor="#F5F5F5"
                    app:chipStrokeColor="#E0E0E0"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_danh_gia"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đánh giá rèn luyện"
                    app:chipBackgroundColor="#F5F5F5"
                    app:chipStrokeColor="#E0E0E0"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ktx"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ký túc xá"
                    app:chipBackgroundColor="#F5F5F5"
                    app:chipStrokeColor="#E0E0E0"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════
         DANH SÁCH KẾT QUẢ
         ══════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:visibility="gone"
        tools:listitem="@layout/item_search_result" />

    <!-- ══════════════════════════════════════════════
         EMPTY STATE — "Không tìm thấy kết quả"
         ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="60dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_search"
            android:alpha="0.25"
            android:contentDescription="Không có kết quả" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không tìm thấy kết quả cho"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_empty_query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            tools:text="&quot;học bổng&quot;" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy thử từ khóa khác"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>