<?xml version="1.0" encoding="utf-8"?>
<!-- item_assessment_deduction.xml (fix_v4) - bỏ drawableEnd, click thẳng để chọn -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFF5F5">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#FFCCCC"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:minHeight="52dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvDeductionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/assessment_deduction_red"
                android:lineSpacingMultiplier="1.3"/>

            <TextView
                android:id="@+id/tvPenalty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#FF6666"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- FIX: bỏ drawableEnd, click thẳng để mở dropdown -->
        <AutoCompleteTextView
            android:id="@+id/actvDeductionScore"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_score_box"
            android:backgroundTint="#FFF5F5"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center"
            android:inputType="none"
            android:textSize="14sp"
            android:textColor="@color/assessment_deduction_red"
            android:textStyle="bold"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:cursorVisible="false"/>

    </LinearLayout>

</LinearLayout>