<?xml version="1.0" encoding="utf-8"?><!--
    fragment_notification.xml
    ─────────────────────────────────────────────────────────────
    Trang thông báo Gmail sinh viên UTC2.
    Hiển thị email từ tài khoản mssv@st.utc2.edu.vn dưới dạng card.

    Cấu trúc:
      LinearLayout (root, vertical)
        ├── View  status_bar_spacer         (giống HomeFragment)
        ├── Toolbar  (nút back + tiêu đề)
        └── NestedScrollView
              └── LinearLayout
                    ├── CardView  card_gmail_info  (hướng dẫn + nút mở Gmail)
                    └── RecyclerView  rv_notifications
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Status bar spacer (giống HomeFragment — set height bằng Java) -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/toolbar_collapsed_bg" />

    <!-- ── Toolbar ── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_collapsed_bg"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nút back -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:contentDescription="Quay lại"
                app:tint="#FFFFFF" />

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Thông báo Email"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Nút mở Gmail app trực tiếp -->
            <ImageButton
                android:id="@+id/btn_open_gmail"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_open_in_new"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:contentDescription="Mở Gmail"
                app:tint="#FFFFFF" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- ── Nội dung cuộn ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── Card thông tin tài khoản Gmail SV ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gmail_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row: icon Gmail + tiêu đề -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <!-- Icon Gmail placeholder (dùng ic_email hoặc drawable Gmail) -->
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_email"
                            android:scaleType="centerInside"
                            android:contentDescription="Gmail" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email sinh viên UTC2"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_gmail_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mssv@st.utc2.edu.vn"
                                android:textSize="12sp"
                                android:textColor="#757575"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Badge trạng thái -->
                        <TextView
                            android:id="@+id/tv_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Hoạt động"
                            android:textSize="11sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="12dp" />

                    <!-- Mô tả ngắn -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhấn nút bên dưới để mở Gmail và xem toàn bộ thông báo từ nhà trường gửi đến hộp thư sinh viên của bạn."
                        android:textSize="13sp"
                        android:textColor="#616161"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="14dp" />

                    <!-- Nút mở Gmail lọc domain -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_in_gmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Mở hộp thư Gmail sinh viên"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/accent_yellow_dark"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_open_in_new"
                        app:iconTint="#FFFFFF"
                        app:iconPadding="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Tiêu đề section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông báo gần đây"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp" />

            <!-- ── Trạng thái loading / empty ── -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_notification"
                    android:alpha="0.3"
                    android:scaleType="centerInside"
                    android:contentDescription="Không có thông báo" />

                <TextView
                    android:id="@+id/tv_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có thông báo nào"
                    android:textSize="14sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- ── RecyclerView danh sách thông báo ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>