<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ═══════════════════════════════════════════════════════
         TOP BAR — Giữ nguyên bố cục RelativeLayout + các id.
         Thay đổi: thêm bottom-divider màu #FFC107 để nhấn brand.
         ═══════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Nút Back — giữ nguyên id, vị trí, kích thước -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/black" />

        <!-- Tiêu đề — giữ nguyên text ref, căn giữa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/profile_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:textColor="@color/black" />

        <!-- Accent line dưới AppBar — brand touch #FFC107 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:background="#FFC107" />

    </RelativeLayout>

    <!-- ═══════════════════════════════════════════════════════
         SCROLLABLE CONTENT — Giữ nguyên ScrollView + weight
         ═══════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ─────────────────────────────────────────────
                 CARD 1: Avatar / Student Card
                 Giữ nguyên: id, kích thước 200dp, scaleType.
                 Thay đổi: border accent #FFC107, bg #FFF3CD.
                 ───────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFF3CD">

                <ImageView
                    android:id="@+id/imgStudentCard"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/ic_user"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="24dp" />

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────────────────────────
                 RECYCLER VIEW — Giữ nguyên hoàn toàn.
                 (Re-skin icon container → #FFF3CD xử lý
                  tại Adapter, không thuộc scope file này.)
                 ───────────────────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ─────────────────────────────────────────────
                 BUTTON: Chương trình đào tạo
                 Style: Pill • Nền #000000 • Chữ #FFFFFF
                 Giữ nguyên: id, marginTop, height, text ref.
                 ───────────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrainingProgram"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/training_program"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="#000000"
                app:cornerRadius="28dp"
                app:elevation="0dp" />

            <!-- ─────────────────────────────────────────────
                 BUTTON: Hỗ trợ
                 Style: Pill • Nền #000000 • Chữ #FFFFFF
                 Giữ nguyên: id, marginTop, height, text ref.
                 ───────────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/title_support"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="#000000"
                app:cornerRadius="28dp"
                app:elevation="0dp" />

            <!-- ─────────────────────────────────────────────
                 BUTTON: Đăng xuất
                 Style: Pill • Nền #FFC107 (Amber) • Chữ #000000
                 Lý do: Duy trì palette vàng-đen-trắng,
                 phân biệt với 2 nút chính bằng màu Amber.
                 Giữ nguyên: id, marginTop, marginBottom, text ref.
                 ───────────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/logout"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="#FFC107"
                app:cornerRadius="28dp"
                app:elevation="0dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>